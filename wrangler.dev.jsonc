{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clear-clef",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Omit WORKER_SELF_REFERENCE: next dev runs in Node, not the built Worker, so the
  // self-service binding triggers a harmless-but-noisy workerd RPC error on first request.
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache",
    "BETTER_AUTH_URL": "http://localhost:3000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clear-clef",
      "database_id": "f5e030c1-90d1-48d9-bd98-5b986a78d745",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SCORES_BUCKET",
      "bucket_name": "clear-clef",
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "clear-clef",
    },
  ],
}
