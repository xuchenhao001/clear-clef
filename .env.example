# Optional mirror for Next.js process.env during `pnpm dev`.
# OpenNext also reads secrets from `.dev.vars` via Cloudflare `env` bindings.
# Copy to `.env.local` if you prefer standard Next env loading.

NEXTJS_ENV=development
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
