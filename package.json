{
  "name": "clear-clef",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "cf dev",
    "build": "tsc --noEmit && cf build",
    "preview": "pnpm build && vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "cf-typegen": "cf workers types --no-include-runtime",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/d1-migrate-local.mjs",
    "db:ensure:local": "node scripts/ensure-local-d1.mjs",
    "db:migrate:remote": "node scripts/d1-migrate-remote.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@fontsource/bitter": "^5.2.5",
    "@fontsource/geist-mono": "^5.2.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "verovio": "^6.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^13.0.3",
    "cf": "1.0.0-beta.18",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
