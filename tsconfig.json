{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "env.d.ts",
    ".cloudflare/types/index.d.ts",
    "types/**/*.d.ts",
    "src/**/*.ts",
    "src/vite-env.d.ts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "tests/**/*.ts",
    "vite.config.ts",
    "cloudflare.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
